# Local Docker run on a laptop. Copy, do not edit in TextEdit:
#
#   cp .env.local.example .env
#   echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
#   nano .env          # set OPENROUTER_API_KEY, then Ctrl-O, Enter, Ctrl-X
#
# Then: docker compose up --build
#
# Checked against docker-compose.yml. Every value here is already correct for
# localhost; the only one you MUST supply is the OpenRouter key.

# --- database (local container) ---------------------------------------------
POSTGRES_USER=yik
POSTGRES_PASSWORD=yik
POSTGRES_DB=yik

# --- app ---------------------------------------------------------------------
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Compose sets NODE_ENV=production, which makes COOKIE_SECURE default to true.
# Safari refuses a Secure cookie over plain http://, so admin login would appear
# to work and bounce straight back to the login screen. Off for localhost.
COOKIE_SECURE=false

# --- admin panel ---------------------------------------------------------------
ADMIN_EMAIL=admin@markaz.uz
ADMIN_PASSWORD=change-this-now
# JWT_SECRET is appended by the openssl line above. It must be 16+ characters or
# the app refuses to start.

# --- first run: no Telegram bot, no payments ---------------------------------
# AUTH_REQUIRED defaults to ON and then demands a real bot before it will boot.
AUTH_REQUIRED=false
AUTH_REQUIRE_PHONE=true
DELIVERY_PROVIDER=console
PAYMENTS_ENABLED=false
REPORT_PRICE_UZS=49000

# --- the model -----------------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-REPLACE-ME
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
OPENROUTER_SITE_NAME=CareerKids
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- limits (the default of 5 sittings a day blocks a testing afternoon) ------
RL_SESSIONS_PER_DAY=100
RL_MESSAGES_PER_MIN=60
RL_ADMIN_LOGIN_PER_MIN=20
MAX_TURNS=60
MAX_MESSAGE_CHARS=2000
MIN_ANSWERS_FOR_REPORT=1

# --- model budget ---------------------------------------------------------------
CONVERSATION_MAX_TOKENS=1500
REPORT_MAX_TOKENS=4500
REPORT_TIMEOUT_MS=180000
# Zero so the admin cost dashboard does not invent a bill for a free model.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# --- retention -------------------------------------------------------------------
RETENTION_MONTHS=24
ANALYTICS_RETENTION_DAYS=180
BACKUP_KEEP_DAYS=14
CONSENT_TEXT_VERSION=uz-2026-07

# --- reminders (off: they need a bot and they message real people) -----------
REMINDERS_ENABLED=false
